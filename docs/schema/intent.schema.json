{
  "$defs": {
    "Capability": {
      "description": "Capability taxonomy v1 (PLAN.md \u00a74.3).",
      "enum": [
        "FS_READ",
        "FS_WRITE",
        "FS_DELETE",
        "FS_ENUMERATE",
        "ENV_READ",
        "CREDENTIAL_ACCESS",
        "NET_OUTBOUND",
        "NET_INBOUND",
        "DNS",
        "DOWNLOAD_EXEC",
        "PROC_EXEC",
        "CODE_EVAL",
        "PRIV_ESCALATION",
        "PERSISTENCE",
        "SYS_CONFIG_MODIFY",
        "PKG_INSTALL",
        "ENCODE_OBFUSCATE",
        "DATA_TRANSFORM",
        "AGENT_INSTRUCTION",
        "TOOL_PERMISSION",
        "EXTERNAL_API",
        "USER_INTERACTION",
        "COMPOSITE"
      ],
      "title": "Capability",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A span plus the text it points at. `quote` must appear within those lines.",
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line_start",
        "line_end",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Modality": {
      "enum": [
        "functional",
        "security",
        "scope",
        "data-handling"
      ],
      "title": "Modality",
      "type": "string"
    },
    "Polarity": {
      "enum": [
        "positive",
        "negative"
      ],
      "title": "Polarity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^I\\d+$",
      "title": "Id",
      "type": "string"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "action": {
      "title": "Action",
      "type": "string"
    },
    "object": {
      "title": "Object",
      "type": "string"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "polarity": {
      "$ref": "#/$defs/Polarity",
      "default": "positive"
    },
    "modality": {
      "$ref": "#/$defs/Modality",
      "default": "functional"
    },
    "expected_capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "title": "Expected Capabilities",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "id",
    "action",
    "object",
    "sources"
  ],
  "title": "Intent",
  "type": "object"
}
